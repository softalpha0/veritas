{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "data/**"
    }
  },
  "rewrites": [
    { "source": "/app", "destination": "/app.html" },
    { "source": "/report", "destination": "/report.html" },
    { "source": "/api/(.*)", "destination": "/api/index?path=/api/$1" }
  ]
}
